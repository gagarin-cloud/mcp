{
  "name": "@gagarin-cloud/mcp",
  "version": "0.3.0",
  "description": "Deploy with ease. Maintain without fear. gagarin's MCP server: your agent ships the app; alerts, logs, project memory and approval-gated deletes come with it.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://gagarin.cloud",
  "bugs": {
    "url": "https://github.com/gagarin-cloud/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gagarin-cloud/mcp.git"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "gagarin",
    "paas",
    "deploy",
    "kubernetes",
    "agent"
  ],
  "bin": {
    "gagarin-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/http.js",
    "stdio": "node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "3.9.9",
    "typescript": "^5.9.3"
  }
}
